# Browser-safe Supabase project settings. These values are public by design; database access is protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Never add a Supabase service-role key here or to any VITE_ variable.
# Privileged keys belong only in the Supabase Edge Function secret environment.
